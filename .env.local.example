# ── Supabase ──────────────────────────────────────────────────────────────────
# Server-only. NEVER prefix with NEXT_PUBLIC_
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Gmail OAuth2 ───────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com
# For LOCAL dev, Redirect URI = http://localhost:3000/api/auth/callback/google
# For PRODUCTION on Vercel, Redirect URI = https://<your-domain>/api/auth/callback/google
#   → Add both URIs as Authorized redirect URIs in Google Cloud Console
#   → Set GOOGLE_REDIRECT_URI to the production URL when deploying to Vercel
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=https://<your-domain>.vercel.app/api/auth/callback/google
# Obtained by visiting /api/auth/gmail/start once (do this in local dev first)
GOOGLE_REFRESH_TOKEN=

# ── AI provider ───────────────────────────────────────────────────────────────
# Default memakai DeepSeek. Kosongkan ketiga AI_* di bawah untuk memakai default.
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxx

# Override opsional — arahkan ke endpoint OpenAI-compatible mana pun.
# Contoh Ollama lokal:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.2:3b
# Catatan: pada satu sampel uji, llama3.2:3b mengembalikan type "KREDIT" untuk
# pembayaran merchant yang jelas keluar, dan kategori "Shopping" untuk kedai
# kopi. Validasi Zod tidak bisa menangkap ini — "KREDIT" adalah nilai enum yang
# sah, jadi retry tidak terpicu dan transaksi tersimpan dengan tanda terbalik.
# Verifikasi hasilnya dengan `npm run verify:parser` sebelum dipakai serius.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# ── Vercel Cron ────────────────────────────────────────────────────────────────
# Random secret to protect the cron endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both vars MUST be set to the SAME value:
#   CRON_SECRET        → used server-side (route.ts) to validate the Authorization header
#   NEXT_PUBLIC_CRON_SECRET → used client-side (SyncButton / ClientDashboard) to send the header
CRON_SECRET=
NEXT_PUBLIC_CRON_SECRET=
